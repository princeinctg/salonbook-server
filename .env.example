# Server Environment Variables Example
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.x00eiws.mongodb.net/

# Better Auth & JWT Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=https://your-backend.onrender.com
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# MUST be registered verbatim in Google Cloud Console > APIs & Services > Credentials
# > OAuth 2.0 Client > Authorized redirect URIs (on the SAME client as GOOGLE_CLIENT_ID).
# The client-side callback route forwards the code to the API.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Alternative (direct API callback): http://localhost:5000/api/auth/google/callback
# Use only after that exact URI is registered on the same OAuth client.

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ImgBB Image Upload
IMGBB_API_KEY=your_imgbb_api_key

# Client and Server URLs for CORS & Redirects
CLIENT_URL=https://your-frontend.vercel.app
SERVER_URL=https://your-backend.onrender.com
