# Server Environment Variables Example
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/salonbook

# Better Auth & JWT Configuration
BETTER_AUTH_SECRET=salonbook_super_secure_better_auth_secret_key_32chars_min
BETTER_AUTH_URL=http://localhost:5000
JWT_SECRET=salonbook_super_secure_better_auth_secret_key_32chars_min
JWT_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_51Pxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ImgBB Image Upload
IMGBB_API_KEY=your_imgbb_api_key_here

# Client and Server URLs for CORS & Redirects
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
